# Copy to contracts/.env (never commit the real file) and `source .env`.

# Deployer private key (0x-prefixed). Use a dedicated testnet wallet.
PRIVATE_KEY=

# Optional: final owner (e.g. a hardware wallet). Defaults to the deployer.
# If set, that address must call acceptOwnership() on TrueAlert afterwards.
OWNER=

# Optional: existing USDC address. Leave empty on testnet to deploy MockUSDC.
# Mainnet (Hyperlane-bridged USDC): 0x3187deAd7A2Bd6770F5Fe81495D1B715926AAe6e
USDC=
