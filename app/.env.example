# Copy to .env.local for development.

# Which network the app talks to: local | testnet | mainnet
NEXT_PUBLIC_CHAIN=testnet

# Optional RPC override (defaults to the chain's public RPC).
NEXT_PUBLIC_RPC_URL=

# Deployed contracts (see contracts/README.md).
NEXT_PUBLIC_TRUEALERT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# The "TrueAlert Resolution" arbiter wallet offered to sellers and recognised
# on the buyer page. Any other arbiter is shown to buyers with a warning.
NEXT_PUBLIC_ARBITER_ADDRESS=

# Optional WalletConnect Cloud project ID (https://cloud.reown.com).
# Without it only browser-injected wallets (incl. wallet in-app browsers) work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
